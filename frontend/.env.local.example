# Copy to .env.local. NEXT_PUBLIC_* values are visible in the browser: never put secrets here.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Set to "true" to use lib/mocks.ts instead of the real backend (default while backend is not ready)
NEXT_PUBLIC_USE_MOCKS=true

# Optional cold-start tuning (milliseconds). Defaults: show banner after 2500, give up after 90000.
# NEXT_PUBLIC_WAKE_SHOW_AFTER_MS=2500
# NEXT_PUBLIC_WAKE_DEADLINE_MS=90000

# Firebase web config (Firebase console > Project settings > Your apps > Web app). Public by design, not secrets.
# Leave empty to run in demo mode (no Google sign-in).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Web Push public key (Firebase console > Project settings > Cloud Messaging > Web Push certificates). Public by design.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
