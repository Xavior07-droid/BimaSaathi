        "pre_existing_months": {
          "minimum": 0,
          "nullable": true,
          "type": "integer"
        },
        "specific_diseases_months": {
          "minimum": 0,
          "nullable": true,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
