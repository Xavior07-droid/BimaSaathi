        "value": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "start_date": {
      "format": "date",
      "nullable": true,
      "type": "string"
    },
    "sub_limits": {
      "items": {
        "properties": {
          "item": {
            "minLength": 1,
            "type": "string"
          },
          "limit": {
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "source": {
            "properties": {
              "clause": {
                "description": "Clause / section number or heading, e.g. '4.2' or 'Exclusions'",
                "minLength": 1,
                "type": "string"
              },
              "page": {
                "description": "1-based page number from the [Page N] marker",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "page",
