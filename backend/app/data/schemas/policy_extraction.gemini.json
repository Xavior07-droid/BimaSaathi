{
  "description": "What the FIRST Gemini call returns (facts only, no translations).",
  "properties": {
    "claim_requirements": {
      "properties": {
        "cashless": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "intimation_deadline_hours": {
          "minimum": 0,
          "nullable": true,
          "type": "integer"
        },
        "reimbursement": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "copay_percent": {
      "maximum": 100,
      "minimum": 0,
      "nullable": true,
      "type": "number"
    },
    "covered": {
      "items": {
        "properties": {
          "source": {
            "properties": {
              "clause": {
                "description": "Clause / section number or heading, e.g. '4.2' or 'Exclusions'",
                "minLength": 1,
                "type": "string"
              },
              "page": {
                "description": "1-based page number from the [Page N] marker",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "page",
              "clause"
            ],
            "type": "object"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "text",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "end_date": {
      "format": "date",
      "nullable": true,
      "type": "string"
    },
    "exclusions": {
      "items": {
        "properties": {
          "source": {
            "properties": {
              "clause": {
                "description": "Clause / section number or heading, e.g. '4.2' or 'Exclusions'",
                "minLength": 1,
                "type": "string"
              },
              "page": {
                "description": "1-based page number from the [Page N] marker",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "page",
              "clause"
            ],
            "type": "object"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "text",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "holder_name": {
      "nullable": true,
      "type": "string"
    },
    "insurer": {
      "nullable": true,
      "type": "string"
    },
    "policy_no": {
      "nullable": true,
      "type": "string"
    },
    "policy_type": {
      "enum": [
        "health",
        "motor",
        "life"
      ],
      "nullable": true,
      "type": "string"
    },
    "premium": {
      "minimum": 0,
      "nullable": true,
      "type": "integer"
    },
    "renewal_date": {
      "format": "date",
      "nullable": true,
      "type": "string"
