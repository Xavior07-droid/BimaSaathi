{
  "$defs": {
    "ClaimRequirements": {
      "additionalProperties": false,
      "properties": {
        "cashless": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Cashless",
          "type": "array"
        },
        "intimation_deadline_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intimation Deadline Hours"
        },
        "reimbursement": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reimbursement",
          "type": "array"
        }
      },
      "title": "ClaimRequirements",
      "type": "object"
    },
    "CoveredItem": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "title": "CoveredItem",
      "type": "object"
    },
    "ExclusionItem": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "title": "ExclusionItem",
      "type": "object"
    },
    "RoomRentCap": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "per_day",
            "percent_of_sum_insured"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "RoomRentCap",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "clause": {
          "description": "Clause / section number or heading, e.g. '4.2' or 'Exclusions'",
          "minLength": 1,
          "title": "Clause",
          "type": "string"
        },
        "page": {
          "description": "1-based page number from the [Page N] marker",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "clause"
      ],
      "title": "Source",
      "type": "object"
    },
    "SubLimit": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "item",
        "source"
      ],
      "title": "SubLimit",
      "type": "object"
    },
    "WaitingPeriods": {
      "additionalProperties": false,
      "properties": {
        "initial_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Days"
        },
        "pre_existing_months": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Existing Months"
        },
        "specific_diseases_months": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specific Diseases Months"
        }
      },
      "title": "WaitingPeriods",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the FIRST Gemini call returns (facts only, no translations).",
  "properties": {
    "claim_requirements": {
      "$ref": "#/$defs/ClaimRequirements"
    },
    "copay_percent": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Copay Percent"
    },
    "covered": {
      "items": {
        "$ref": "#/$defs/CoveredItem"
      },
      "title": "Covered",
      "type": "array"
    },
    "end_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Date"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/ExclusionItem"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "holder_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holder Name"
    },
    "insurer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Insurer"
    },
    "policy_no": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy No"
    },
    "policy_type": {
      "anyOf": [
        {
          "enum": [
            "health",
            "motor",
            "life"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Type"
    },
    "premium": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Premium"
    },
    "renewal_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Renewal Date"
    },
    "room_rent_cap": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoomRentCap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "start_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Date"
    },
    "sub_limits": {
      "items": {
        "$ref": "#/$defs/SubLimit"
      },
      "title": "Sub Limits",
      "type": "array"
    },
    "sum_insured": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sum Insured"
    },
    "waiting_periods": {
      "$ref": "#/$defs/WaitingPeriods"
    }
  },
  "title": "PolicyExtraction",
  "type": "object"
}
